import sys
import json
import uuid
from datetime import datetime, timezone
from pathlib import Path

sys.path.insert(0, 'src')

from ingestion.mplads_api import MPLADSClient
from database import init_database, session_scope
from database.models import PipelineRun, Project, Expenditure
from processing.data_audit import run_data_audit
from ingestion.transform import transform_data


DATASETS = ["Works Recommended", "Works Completed", "Expenditure Incurred"]


def save_raw_snapshot(run_id: str, datasets: dict[str, list]):
    raw_dir = Path(f"data/raw/{run_id}")
    raw_dir.mkdir(parents=True, exist_ok=True)
    for name, data in datasets.items():
        filename = name.lower().replace(" ", "_") + ".json"
        (raw_dir / filename).write_text(json.dumps(data, indent=2, default=str))
    manifest = {
        "run_id": run_id,
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "datasets": {name: len(data) for name, data in datasets.items()},
    }
    (raw_dir / "manifest.json").write_text(json.dumps(manifest, indent=2))


def store_in_database(run_id: str, datasets: dict[str, list], pipeline_version: str = "1.0"):
    with session_scope() as session:
        pipeline_run = PipelineRun(
            run_id=run_id,
            pipeline_version=pipeline_version,
            source_snapshot_id=run_id,
            status="completed",
            started_at=datetime.now(timezone.utc),
            completed_at=datetime.now(timezone.utc),
        )
        session.add(pipeline_run)
        session.flush()

        work_id_to_project_id = {}

        if "Works Recommended" in datasets:
            for record in datasets["Works Recommended"]:
                work_id = str(record.get("workId", "")).strip()
                if not work_id:
                    continue
                project = Project(
                    run_id=run_id,
                    work_id=work_id,
                    state=record.get("state"),
                    district=record.get("district"),
                    constituency=record.get("constituency"),
                    mp_name=record.get("mpName"),
                    work_name=record.get("workName"),
                    work_category=record.get("workCategory"),
                    sub_category=record.get("subCategory"),
                    agency_name=record.get("agencyName"),
                    recommended_amount=record.get("recommendedAmount"),
                    sanction_amount=record.get("sanctionAmount"),
                    recommended_date=parse_date(record.get("recommendedDate")),
                    sanction_date=parse_date(record.get("sanctionDate")),
                    completion_date=parse_date(record.get("completionDate")),
                    work_status=record.get("workStatus"),
                    latitude=record.get("latitude"),
                    longitude=record.get("longitude"),
                    raw_data=record,
                )
                session.add(project)
                session.flush()
                work_id_to_project_id[work_id] = project.id

        if "Works Completed" in datasets:
            for record in datasets["Works Completed"]:
                work_id = str(record.get("workId", "")).strip()
                if not work_id:
                    continue
                project_id = work_id_to_project_id.get(work_id)
                if project_id is None:
                    project = Project(
                        run_id=run_id,
                        work_id=work_id,
                        state=record.get("state"),
                        district=record.get("district"),
                        constituency=record.get("constituency"),
                        mp_name=record.get("mpName"),
                        work_name=record.get("workName"),
                        work_category=record.get("workCategory"),
                        sub_category=record.get("subCategory"),
                        agency_name=record.get("agencyName"),
                        recommended_amount=record.get("recommendedAmount"),
                        sanction_amount=record.get("sanctionAmount"),
                        recommended_date=parse_date(record.get("recommendedDate")),
                        sanction_date=parse_date(record.get("sanctionDate")),
                        completion_date=parse_date(record.get("completionDate")),
                        work_status=record.get("workStatus"),
                        latitude=record.get("latitude"),
                        longitude=record.get("longitude"),
                        raw_data=record,
                    )
                    session.add(project)
                    session.flush()
                    work_id_to_project_id[work_id] = project.id

        if "Expenditure Incurred" in datasets:
            for record in datasets["Expenditure Incurred"]:
                work_id = str(record.get("workId", "")).strip()
                if not work_id:
                    continue
                project_id = work_id_to_project_id.get(work_id)
                if project_id is None:
                    continue
                expenditure = Expenditure(
                    run_id=run_id,
                    project_id=project_id,
                    work_id=work_id,
                    expenditure_amount=record.get("expenditureAmount"),
                    expenditure_date=parse_date(record.get("expenditureDate")),
                    expenditure_year=extract_year(record.get("expenditureDate")),
                    raw_data=record,
                )
                session.add(expenditure)

        session.commit()
    print(f"Stored {sum(len(d) for d in datasets.values())} records in database")


def parse_date(value):
    if value is None:
        return None
    if isinstance(value, (int, float)):
        return None
    for fmt in ("%d-%m-%Y", "%d/%m/%Y", "%Y-%m-%d", "%d-%b-%Y", "%d %b %Y"):
        try:
            return datetime.strptime(str(value).strip(), fmt).date()
        except ValueError:
            continue
    return None


def extract_year(value):
    dt = parse_date(value)
    return dt.year if dt else None


def main():
    run_id = datetime.now(timezone.utc).strftime("%Y%m%d_%H%M%S") + "_" + uuid.uuid4().hex[:8]
    print(f"Run ID: {run_id}")

    init_database()

    client = MPLADSClient()
    print("Initializing session...")
    client.initialize_session()

    datasets = {}
    for dataset_name in DATASETS:
        print(f"Fetching {dataset_name}...")
        try:
            data = client.fetch_report(dataset_name)
            if isinstance(data, list):
                datasets[dataset_name] = data
                print(f"  Got {len(data)} records")
            else:
                print(f"  Unexpected response type: {type(data)}")
                datasets[dataset_name] = []
        except Exception as e:
            print(f"  Error fetching {dataset_name}: {e}")
            datasets[dataset_name] = []

    print("\nSaving raw snapshots...")
    save_raw_snapshot(run_id, datasets)

    print("Storing in database...")
    store_in_database(run_id, datasets)

    print("Running data audit...")
    report_path = run_data_audit(run_id, datasets)
    print(f"Data quality report saved to: {report_path}")

    print("\nRunning data transformation...")
    try:
        projects_df, expenditures_df = transform_data(run_id)
        print(f"Transformation complete: {len(projects_df)} projects, {len(expenditures_df)} expenditure groups")
        print(f"Processed data saved to data/projects/")
    except Exception as e:
        print(f"Error during transformation: {e}")
        import traceback
        traceback.print_exc()

    print("\nDone!")


if __name__ == "__main__":
    main()